{
  "name": "actual",
  "version": "0.0.1",
  "private": true,
  "description": "A local-first personal finance system",
  "homepage": "https://github.com/actualbudget/actual/",
  "bugs": {
    "url": "https://github.com/actualbudget/actual/issues/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:actualbudget/actual.git"
  },
  "scripts": {
    "start": "pnpm run start:browser",
    "start:server": "pnpm --filter @actual-app/sync-server run start",
    "start:server-monitor": "pnpm --filter @actual-app/sync-server run start-monitor",
    "start:server-dev": "NODE_ENV=development BROWSER_OPEN=localhost:5006 npm-run-all --parallel 'start:server-monitor' 'start'",
    "start:desktop": "pnpm run desktop-dependencies && npm-run-all --parallel 'start:desktop-*'",
    "start:docs": "pnpm --filter docs run start",
    "desktop-dependencies": "npm-run-all --parallel rebuild-electron build:plugins-service",
    "start:desktop-node": "pnpm --filter @actual-app/core run watch:node",
    "start:desktop-client": "pnpm --filter @actual-app/web run watch",
    "start:desktop-server-client": "pnpm --filter @actual-app/web run build:browser",
    "start:desktop-electron": "pnpm --filter desktop-electron run watch",
    "start:browser": "npm-run-all --parallel 'start:browser-*' 'start:service-plugins'",
    "start:service-plugins": "pnpm --filter plugins-service run watch",
    "start:browser-frontend": "pnpm --filter @actual-app/web run start:browser",
    "start:storybook": "pnpm --filter @actual-app/components run start:storybook",
    "build": "lage build",
    "start:ios": "pnpm run build:browser && pnpm --filter mobile-client run start:ios",
    "start:android": "pnpm run build:browser && pnpm --filter mobile-client run start:android",
    "build:server": "pnpm run build:browser && pnpm --filter @actual-app/sync-server run build",
    "build:browser": "./bin/package-browser",
    "build:desktop": "./bin/package-electron",
    "build:plugins-service": "pnpm --filter plugins-service run build",
    "build:api": "lage build --scope=@actual-app/api",
    "build:mobile": "lage build --scope=mobile-client",
    "build:cli": "lage build --scope=@actual-app/cli",
    "build:docs": "pnpm --filter docs run build",
    "build:storybook": "pnpm --filter @actual-app/components run build:storybook",
    "deploy:docs": "pnpm --filter docs run deploy",
    "generate:i18n": "pnpm --filter @actual-app/web run generate:i18n",
    "generate:release-notes": "node ./bin/release-note-generator.mts",
    "generate:news-feed": "pnpm --filter @actual-app/ci-actions exec tsx bin/generate-news-feed.ts",
    "test": "lage test --continue",
    "test:debug": "lage test --no-cache --continue",
    "e2e": "pnpm --filter @actual-app/web run e2e",
    "e2e:desktop": "pnpm --filter desktop-electron run e2e",
    "playwright": "pnpm --filter @actual-app/web run playwright",
    "vrt": "pnpm --filter @actual-app/web run vrt",
    "vrt:docker": "./bin/run-vrt",
    "rebuild-electron": "./node_modules/.bin/electron-rebuild -m ./packages/desktop-electron -o better-sqlite3,bcrypt,argon2 --build-from-source -f",
    "rebuild-node": "pnpm --filter @actual-app/core rebuild",
    "lint": "oxfmt --check . && oxlint --type-aware --quiet",
    "lint:fix": "oxfmt . && oxlint --fix --type-aware --quiet",
    "knip": "knip",
    "install:server": "pnpm install --prod --frozen-lockfile --filter @actual-app/sync-server...",
    "typecheck": "lage type-check",
    "typecheck:root": "tsgo -p tsconfig.root.json --noEmit",
    "check:tsconfig-references": "workspaces-to-typescript-project-references --check",
    "sync:tsconfig-references": "workspaces-to-typescript-project-references",
    "prepare": "husky"
  },
  "devDependencies": {
    "@monorepo-utils/workspaces-to-typescript-project-references": "^2.11.0",
    "@octokit/rest": "catalog:",
    "@types/node": "catalog:",
    "@types/prompts": "^2.4.9",
    "@typescript/native-preview": "catalog:",
    "eslint": "^10.12.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-typescript-paths": "^0.0.33",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "lage": "^2.17.0",
    "minimatch": "catalog:",
    "nano-staged": "^1.0.2",
    "npm-run-all": "catalog:",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "p-limit": "^7.3.3",
    "prompts": "^2.4.2",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "browserslist": [
    "electron >= 35.0",
    "defaults"
  ],
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=12.8.1"
  },
  "packageManager": "pnpm@12.8.1"
}
