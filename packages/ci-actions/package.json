{
  "name": "@actual-app/ci-actions",
  "private": true,
  "type": "module",
  "scripts": {
    "tsx": "bin/tsx",
    "test": "pnpm run test:unit",
    "test:unit": "vitest --run && pnpm --workspace-root exec vitest --run --root bin",
    "type-check": "pnpm --workspace-root run typecheck:root && tsgo -b"
  },
  "devDependencies": {
    "@octokit/rest": "catalog:",
    "@typescript/native-preview": "catalog:",
    "extensionless": "^2.0.6",
    "gray-matter": "^4.0.3",
    "listify": "^1.0.3",
    "vitest": "catalog:"
  },
  "extensionless": {
    "lookFor": [
      "ts"
    ]
  }
}
